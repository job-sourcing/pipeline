#!/usr/bin/env bash
# wfetch — universal resilient web fetcher with auto-escalation.
# Usage: wfetch URL [--mode auto|local|supabase|netlify|firecrawl|zenrows|gha|browser]
#                   [--render] [--antibot] [--region EU] [--extract css] [--out file] [--json]
#         wfetch probe    # ladder health snapshot
#         wfetch gha URL  # GHA remote compute shortcut
set -e
# Find repo root (parent of bin/) — resolve symlinks so PATH symlinks work
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
# Use venv python if present, else system python
if [ -x "/home/z/.venv/bin/python3" ]; then PY="/home/z/.venv/bin/python3"
elif command -v python3 >/dev/null 2>&1; then PY="python3"
else echo "no python3 found" >&2; exit 1; fi
export PYTHONPATH="$REPO_ROOT/lib:${PYTHONPATH:-}"
exec "$PY" -m fetchkit.cli "$@"
