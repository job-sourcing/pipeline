list": null, "process_type": 1}, {"id": "7683853759471012105", "title": "高级关卡策划（开放世界/SOC）", "sub_title": null, "description": "1. 推进地点场所（POI）的关卡设计、制作、调试、问题修复。\n2. 参与城镇布局设计和实现。\n3. 参与大世界宏观布局和相应实现。\n4. 参与其他关卡设计相关的需求设计和反馈。\n5. 负责推进关卡流程、管线、生产和设计规范的改进。\n6. 评估整理工具、功能等方面的需求，对接相关团队推动改进。\n7. 对关卡相关产出和提交进行检查、推动问题修复，并就典型问题组织关卡培训。\n8. 为初级关卡设计师提供地图设计和制作上的指导、反馈、督促。\n9. 参与和其他职能的对接，涉及系统、美术、PCG等。\n10. 在关卡组负责人的指导下开展上述职责的工作。", "requirement": "职位要求\n1. 关卡设计领域有至少2-3年或至少1个3D游戏项目的积累。\n2. 熟悉大世界游戏，有相关项目经验为佳，有相关在线游戏项目经验更佳。\n3. 有关卡相关的原型构建、迭代的丰富经验，熟悉关卡流程和质量等级。\n4. 熟悉至少一个常用商业游戏引擎如Unreal或Unity，对之前项目所用引擎和管线有熟练掌握。\n5. 有策划尤其是关卡方面的技术验证和实现的经验，有代码能力为佳。\n6. 熟悉版本管理、任务和问题追踪、知识库。\n7. 乐于合作，习惯高强度工作，积极面对反馈和意见。\n*8. 有已发布或上线的项目里的工作展示，或个人有代表性的作品的展示为佳。", "job_category": null, "city_info": null, "recruit_type": {"id": "101", "name": "全职", "en_name": "Full-time", "i18n_name": "全职", "depth": 2, "parent": {"id": "1", "name": "社招", "en_name": "Experienced", "i18n_name": "社招", "depth": 1, "parent": null, "children": null, "active_status": 1, "selectability": 1}, "children": null, "active_status": 1, "selectability": 1}, "publish_time": 1789036842870, "job_hot_flag": null, "job_subject": null, "code": null, "department_id": null, "job_function": {"id": "7233699008626133287", "name": "游戏策划", "en_name": null, "i18n_name": "游戏策划", "parent_id": null, "index": null, "active_status": null, "biz_create_time": null, "biz_modify_time": null, "parent": {"id": "7233694510365804811", "name": "产品", "en_name": null, "i18n_name": "产品", "parent_id": null, "index": null, "active_status": null, "biz_create_time": null, "biz_modify_time": null, "parent": null}}, "job_process_id": "7055360233992374564", "recommend_id": null, "city_list": [{"code": "CT_125", "name": "上海", "en_name": "Shanghai", "location_type": null, "i18n_name": "上海", "py_name": null, "mdm_code": null, "node_status": null}], "job_post_info": {"id": null, "job_id": null, "title": null, "sub_title": null, "address_id": null, "address": null, "city": null, "education": null, 