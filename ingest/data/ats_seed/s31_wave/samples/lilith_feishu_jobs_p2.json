求沟通、采购执行、外包服务跟进、部门定制化解决方案制定等工作，满足部门外包需求。\n2. 负责对测试基地人力需求进行深入分析，提前了解业务部门用人规划，协助业务部门提高采购及管理效率，以及探索和落地新的外包模式和方法。\n3. 协助主管进行公司人力外包管理规则流程的刷新，并进行全流程风险管控。\n4. 负责测试基地人力外包供应商管理，协调和优化供应商资源。\n", "requirement": "1. 本科以上学历，三年以上驻场管理工作经验。\n2. 具有数据分析及问题发现能力、风险管理能力以及总结输出能力。\n3. 熟悉人力外包的业务模式，了解行业人力外包或各类用工使用情况，有人力外包管理经验或供应商管理经验者优先。\n4. 熟悉服务采购商务流程，有采购管理经验或供应商管理经验，掌握一定的采购技巧与供应商管理的基本方法。\n5. 有游戏类项目管理经验或外包管理变革经验者优先。\n6. 有较强的自驱力和责任心，具有良好的沟通能力、协调能力和灵活处理问题的能力。\n\n注：Li岗，即莉莉丝外部编制岗位，由莉莉丝负责招聘和管理，与第三方人力外包公司签署劳动合同的全职员工。", "job_category": null, "city_info": null, "recruit_type": {"id": "101", "name": "全职", "en_name": "Full-time", "i18n_name": "全职", "depth": 2, "parent": {"id": "1", "name": "社招", "en_name": "Experienced", "i18n_name": "社招", "depth": 1, "parent": null, "children": null, "active_status": 1, "selectability": 1}, "children": null, "active_status": 1, "selectability": 1}, "publish_time": 1787830023969, "job_hot_flag": null, "job_subject": null, "code": null, "department_id": null, "job_function": {"id": "7233721179344111876", "name": "采购", "en_name": null, "i18n_name": "采购", "parent_id": null, "index": null, "active_status": null, "biz_create_time": null, "biz_modify_time": null, "parent": {"id": "7233694862793001249", "name": "职能", "en_name": null, "i18n_name": "职能", "parent_id": null, "index": null, "active_status": null, "biz_create_time": null, "biz_modify_time": null, "parent": null}}, "job_process_id": "7055360233992374564", "recommend_id": null, "city_list": [{"code": "CT_125", "name": "上海", "en_name": "Shanghai", "location_type": null, "i18n_name": "上海", "py_name": null, "mdm_code": null, "node_status": null}], "job_post_info": {"id": null, "job_id": null, "title": null, "sub_title": null, "address_id": null, "address": null, "city": null, "education": null, "experience": null, "description": null, "requirement": null, "min_salary": null, "max_salary": null, "currency": null, "head_count": null, "crator_id": null, "expiry_time": null, "progress": null, "department_id": null, "job_t