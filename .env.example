# Copy this file to .env and fill in your actual values

# ZenRows API key (for bypassing Cloudflare on ZipRecruiter/Glassdoor)
# Get one at https://app.zenrows.com/register
# Free tier: 5,000 credits/month; Build B1: $19/mo for 45K credits
ZENROWS_API_KEY=

# Supabase Edge Proxy token (public test token works for prototyping)
# Get your own at https://supabase.com/dashboard
SUPABASE_PROXY_TOKEN=supabase-proxy-token-placeholder

# Apify API token (for Indeed data — ZenRows fails on Indeed)
# Get one at https://console.apify.com/account
APIFY_TOKEN=
